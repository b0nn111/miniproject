@import "../login/login.wxss";

.detail-bottom-space {
  padding-bottom: 150rpx;
}

.compact {
  padding: 46rpx 32rpx 24rpx;
}

.compact .logo-mark {
  font-size: 78rpx;
}

.form-card {
  margin-top: 8rpx;
}

.code-btn {
  min-width: 150rpx;
  height: 58rpx;
  border-radius: 30rpx;
  background: #f1f4f9;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #1c2737;
  font-size: 25rpx;
}

.form-section-title {
  margin: 26rpx 0 20rpx;
  font-size: 30rpx;
  font-weight: 800;
}

.type-row {
  display: flex;
  gap: 18rpx;
  margin-bottom: 8rpx;
}

.type-pill {
  height: 54rpx;
  display: flex;
  align-items: center;
  color: #5f6d7f;
}

.type-pill::before {
  content: "";
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  border: 2rpx solid #d8dee9;
  margin-right: 10rpx;
  box-sizing: border-box;
}

.type-pill.active {
  color: #1177f2;
}

.type-pill.active::before {
  border: 8rpx solid #1177f2;
}

.agreement {
  display: flex;
  gap: 12rpx;
  align-items: center;
  padding: 0 36rpx;
  color: #5c6778;
  font-size: 24rpx;
}

.checkbox {
  width: 28rpx;
  height: 28rpx;
  border-radius: 6rpx;
  border: 2rpx solid #b8c2d1;
  box-sizing: border-box;
}

.checkbox.checked {
  background: #1677ff;
  border-color: #1677ff;
}
