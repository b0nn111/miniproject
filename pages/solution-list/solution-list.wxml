<view class="page">
  <view class="appbar">
    <view class="appbar-back" bindtap="goBack">‹</view>
    <view class="appbar-title">解决方案</view>
  </view>
  <view class="content">
    <view class="search">
      <input placeholder="搜索解决方案" bindinput="onSearch" value="{{keyword}}" />
      <view class="search-icon">⌕</view>
    </view>
  </view>
  <view class="filter-page">
    <view class="districts">
      <block wx:for="{{districts}}" wx:key="*this">
        <view class="district {{selectedDistrict === item ? 'active' : ''}}" data-name="{{item}}" bindtap="selectDistrict">{{item}}</view>
      </block>
    </view>
    <view class="list card">
      <block wx:if="{{list.length}}">
        <block wx:for="{{list}}" wx:key="id">
          <view class="list-card" data-id="{{item.id}}" bindtap="goDetail">
            <image class="logo-box image-box" src="/assets/images/logo-solution.jpg" mode="aspectFill" />
            <view class="item-main">
              <view class="item-title">{{item.title}}</view>
              <view class="item-meta">{{item.summary}}</view>
              <view class="item-meta">{{item.provider}}</view>
            </view>
          </view>
        </block>
      </block>
      <view wx:else class="empty">暂无匹配方案</view>
    </view>
  </view>
</view>
