<view class="page">
  <view class="appbar">
    <view class="appbar-back" bindtap="goBack">‹</view>
    <view class="appbar-title">活动专区</view>
  </view>
  <view class="content">
    <view class="search">
      <input placeholder="输入关键字搜索活动" bindinput="onSearch" value="{{keyword}}" />
      <view class="search-icon">⌕</view>
    </view>
  </view>
  <view class="filter-page">
    <view class="districts">
      <block wx:for="{{districts}}" wx:key="*this">
        <view class="district {{selectedDistrict === item ? 'active' : ''}}" data-name="{{item}}" bindtap="selectDistrict">{{item}}</view>
      </block>
    </view>
    <view class="list card">
      <block wx:if="{{list.length}}">
        <block wx:for="{{list}}" wx:key="id">
          <view class="list-card activity-card" data-id="{{item.id}}" bindtap="goDetail">
            <image class="logo-box image-box" src="/assets/images/logo-activity.jpg" mode="aspectFill" />
            <view class="item-main">
              <view class="activity-title-row">
                <view class="item-title">{{item.title}}</view>
                <view class="badge {{item.status === 'open' ? 'green' : 'gray'}}">{{item.status === 'open' ? '可报名' : '已截止'}}</view>
              </view>
              <view class="item-meta">{{item.venue}}</view>
              <view class="item-meta">{{item.venue}} | {{item.time}}</view>
            </view>
          </view>
        </block>
      </block>
      <view wx:else class="empty">暂无匹配活动</view>
    </view>
  </view>
</view>
