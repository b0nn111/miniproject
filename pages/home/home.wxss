.home-content {
  margin-top: -52rpx;
}

.hero {
  height: 340rpx;
  overflow: hidden;
  position: relative;
  background: #143a77;
}

.hero-image {
  width: 100%;
  height: 100%;
  display: block;
}

.dot {
  width: 16rpx;
  height: 16rpx;
  background: #0b1320;
  border-radius: 50%;
  margin: 24rpx auto;
}

.entry-card {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  row-gap: 26rpx;
  padding: 38rpx 20rpx;
}

.entry {
  display: flex;
  align-items: center;
  flex-direction: column;
  gap: 14rpx;
}

.entry-icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 22rpx;
  font-weight: 800;
  background: linear-gradient(140deg, #0d78f2, #2fd4d6);
  box-shadow: 0 10rpx 20rpx rgba(32, 126, 236, .22);
}

.entry-icon-image {
  width: 68rpx;
  height: 68rpx;
}

.entry-label {
  font-size: 26rpx;
  color: #252f40;
}

.news-list {
  padding: 10rpx 26rpx;
}

.news-item {
  display: flex;
  gap: 24rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #edf0f5;
}

.news-item:last-child {
  border-bottom: 0;
}

.news-thumb {
  width: 168rpx;
  height: 116rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
  background: #e6eef8;
}

.officer-strip {
  padding: 8rpx 26rpx;
}

.officer-mini {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #edf0f5;
}

.officer-mini:last-child {
  border-bottom: 0;
}
