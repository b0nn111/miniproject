page {
  background: #f5f7fb;
  color: #172033;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
}

.page {
  min-height: 100vh;
  background: #f5f7fb;
  padding-bottom: 48rpx;
}

.appbar {
  min-height: 148rpx;
  padding: 50rpx 32rpx 18rpx;
  box-sizing: border-box;
  background: linear-gradient(115deg, #22d7d7 0%, #2474f2 58%, #1bcad5 100%);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.appbar-title {
  font-size: 36rpx;
  font-weight: 800;
}

.appbar-back {
  position: absolute;
  left: 28rpx;
  bottom: 24rpx;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  line-height: 1;
}

.content {
  padding: 28rpx 32rpx;
}

.card {
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(25, 66, 130, 0.06);
}

.section-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 36rpx 0 22rpx;
}

.section-title {
  font-size: 38rpx;
  font-weight: 800;
}

.more {
  color: #1677ff;
  font-size: 26rpx;
}

.search {
  height: 72rpx;
  border-radius: 40rpx;
  background: #fff;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 0 24rpx;
  box-shadow: 0 4rpx 18rpx rgba(30, 74, 132, 0.06);
  box-sizing: border-box;
}

.search input {
  flex: 1;
  font-size: 26rpx;
}

.search-icon {
  color: #9aa6b8;
  font-size: 32rpx;
}

.filter-page {
  display: flex;
  padding-top: 24rpx;
}

.districts {
  width: 170rpx;
  flex-shrink: 0;
}

.district {
  height: 86rpx;
  display: flex;
  align-items: center;
  padding-left: 26rpx;
  color: #a4adbb;
  font-weight: 700;
  box-sizing: border-box;
}

.district.active {
  background: #fff;
  color: #172033;
  border-radius: 0 28rpx 28rpx 0;
}

.list {
  flex: 1;
  padding: 0 28rpx 36rpx;
  min-width: 0;
}

.list-card {
  display: flex;
  gap: 24rpx;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #edf0f5;
}

.list-card:last-child {
  border-bottom: 0;
}

.logo-box,
.avatar-box {
  width: 112rpx;
  height: 112rpx;
  flex-shrink: 0;
  border-radius: 12rpx;
  background: linear-gradient(135deg, #e4f4ff, #ffffff);
  color: #1686f7;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 800;
  text-align: center;
}

.avatar-box {
  border-radius: 50%;
  background: linear-gradient(135deg, #d9e8ff, #f8fbff);
  color: #24476f;
}

.item-main {
  flex: 1;
  min-width: 0;
}

.item-title {
  font-size: 31rpx;
  line-height: 1.25;
  font-weight: 800;
  color: #111827;
}

.item-meta {
  margin-top: 10rpx;
  color: #657184;
  font-size: 25rpx;
  line-height: 1.45;
}

.badge {
  display: inline-flex;
  align-items: center;
  height: 40rpx;
  padding: 0 14rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  font-weight: 700;
}

.badge.green {
  color: #fff;
  background: #27c765;
}

.badge.gray {
  color: #fff;
  background: #8d929b;
}

.badge.orange {
  color: #e56a13;
  background: #fff3e8;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 16rpx;
}

.tag {
  border: 1rpx solid #1887ff;
  color: #1177f2;
  border-radius: 6rpx;
  padding: 6rpx 10rpx;
  font-size: 24rpx;
  line-height: 1;
}

.detail-card {
  margin: 24rpx 32rpx;
  padding: 30rpx;
}

.detail-title {
  font-size: 38rpx;
  font-weight: 800;
  line-height: 1.3;
}

.detail-subtitle {
  color: #5e6b7d;
  font-size: 27rpx;
  line-height: 1.5;
  margin-top: 14rpx;
}

.field-row {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  border-bottom: 1rpx solid #eef1f6;
}

.field-label {
  width: 176rpx;
  flex-shrink: 0;
  color: #445166;
}

.field-value,
.field-input {
  flex: 1;
  min-width: 0;
  color: #1d2738;
}

.field-input {
  font-size: 27rpx;
}

.bottom-action {
  position: fixed;
  left: 32rpx;
  right: 32rpx;
  bottom: 28rpx;
  height: 76rpx;
  border-radius: 42rpx;
  background: linear-gradient(100deg, #08a8f7, #22ca5d);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 800;
  box-shadow: 0 12rpx 26rpx rgba(18, 127, 210, 0.22);
}

.empty {
  padding: 88rpx 20rpx;
  color: #94a0b2;
  text-align: center;
}

.muted {
  color: #7a8597;
}
